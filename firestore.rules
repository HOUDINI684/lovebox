rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Toutes les ecritures passent par les fonctions serveur (Admin SDK, qui
    // ignore ces regles). Le client ne peut lire qu'une LOVEBOX payee, par son ID,
    // sans pouvoir lister la collection.
    match /loveboxes/{loveboxId} {
      allow get: if resource.data.paid == true;
      allow list, create, update, delete: if false;

      // Emails, tx_ref, montant : jamais exposes au client.
      match /private/{doc} {
        allow read, write: if false;
      }
    }
  }
}
