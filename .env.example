# --- Front (Vite, expose au navigateur) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=true

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

VITE_API_BASE_URL=

# --- Serveur (fonctions Vercel, jamais expose) ---
APP_URL=http://localhost:5173
# Origines supplementaires autorisees en CORS, separees par des virgules
ALLOWED_ORIGINS=
FIREBASE_SERVICE_ACCOUNT_JSON=
FLW_SECRET_KEY=
# "Secret hash" configure dans Flutterwave > Settings > Webhooks
FLW_SECRET_HASH=
# Optionnel, par defaut ${APP_URL}/paiement/retour
PAYMENT_REDIRECT_URL=
# Optionnel, restreint les medias acceptes a ce compte Cloudinary
CLOUDINARY_CLOUD_NAME=
GMAIL_USER=
GMAIL_APP_PASSWORD=
